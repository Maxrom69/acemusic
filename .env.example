# No environment variables are required by the current standalone static build
# or WordPress plugin. The plugin uses WordPress salts and an encrypted option.
# These placeholders are reserved for a separately implemented standalone
# server proxy; current frontend/build scripts do not read or package them.
# Never use VITE_*, NEXT_PUBLIC_*, or another public build prefix for secrets.
ACEMUSIC_API_BASE_URL=https://api.acemusic.ai
ACEMUSIC_API_KEY=replace-with-server-side-secret
ACEMUSIC_SETTINGS_ENCRYPTION_KEY=base64-encoded-32-byte-server-key
